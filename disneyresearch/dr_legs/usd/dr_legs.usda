#usda 1.0
(
    doc = """
    DR Legs (a.k.a. Dr. Legs)

    A bipedal walking robot with a serial-parallel hybrid leg mechanism that exhibits both passive
    and actuated joints with multiple closed kinematic loops, originally presented by Gim et al. in [1].

    References:
    [1] K. G. Gim, J. Kim, and K. Yamane,
        “Design and fabrication of a bipedal robot using serial-parallel hybrid leg mechanism,”
        IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS), 2018

    Copyright (C) 2026, Disney Enterprises, Inc. All rights reserved.
    """
    defaultPrim = "dr_legs"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonKaminoSceneAPI"]
)
{
    uniform float newton:kamino:constraints:alpha = 0.1
    uniform float newton:kamino:constraints:beta = 0.011
    uniform float newton:kamino:constraints:gamma = 0.05
    uniform float newton:kamino:padmm:complementarityTolerance = 0.0001
    uniform float newton:kamino:padmm:dualTolerance = 0.0001
    uniform float newton:kamino:padmm:primalTolerance = 0.0001
}

def Xform "dr_legs"
{
    def Scope "Joints"
    {
        uniform token purpose = "default"
        token visibility = "inherited"

        def PhysicsRevoluteJoint "j1_l_i" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
