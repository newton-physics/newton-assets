#usda 1.0
(
    defaultPrim = "asRoBallet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @../Payload/Shared.usda@
    ]
    upAxis = "Z"
)

def Xform "asRoBallet"
{
    def Scope "Geometry"
    {
        def Xform "base_link" (
            prepend references = @../Components/Torso.usda@</Torso>
        )
        {
            def Xform "ball_link" (
                prepend references = @../Components/Ball.usda@</Ball>
            )
            {
                def PhysicsSphericalJoint "torso_ball_joint" (
                    prepend apiSchemas = ["MjcJointAPI", "NewtonJointAPI"]
                )
                {
                    uniform double mjc:damping = 0.01
                    float newton:damping = 0.00017453292
                    uniform token physics:axis = "Z"
                    rel physics:body0 = </asRoBallet/Geometry/base_link>
                    rel physics:body1 = </asRoBallet/Geometry/base_link/ball_link>
                    point3f physics:localPos0 = (-0.000184, 0, 0.0027)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }

                over "ball_link_geom"
                {
                    rel material:binding = </asRoBallet/Materials/dark>
                    rel material:binding:physics = </asRoBallet/Physics/PhysicsMaterial>
                }
            }
        }
    }
}
