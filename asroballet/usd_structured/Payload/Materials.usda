#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "asRoBallet"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "asRoBallet"
{
    def Scope "Materials"
    {
        def Material "dark" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/dark>
        )
        {
        }

        def Material "orange" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/orange>
        )
        {
        }
    }
}
