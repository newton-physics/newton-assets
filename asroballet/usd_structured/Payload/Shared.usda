                        over "head_link_geom"
                        {
                            rel material:binding = </asRoBallet/Materials/dark>
                        }

                        over "head_link_collision_geom"
                        {
                            rel material:binding:physics = </asRoBallet/Physics/PhysicsMaterial>
                        }
                    }
                }

                over "right_shoulder_pitch_link"
