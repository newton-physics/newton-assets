        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "base_link_collision_geom"
            {
                rel material:binding:physics = </asRoBallet/Physics/PhysicsMaterial>
            }

            over "torso_link"
            {
                over "torso_link_collision_core"
