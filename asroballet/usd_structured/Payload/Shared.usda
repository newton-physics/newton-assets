#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "asRoBallet"
    doc = "Componentized from the asRoBallet structured USD export."
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./Materials.usda@
    ]
    upAxis = "Z"
)

def Xform "asRoBallet"
{
    def Scope "Physics"
    {
        def Material "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
            float physics:staticFriction = 1
        }

        def MjcActuator "wheel_1_axle_joint"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gear = [2, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/wheel_1_axle_link/wheel_1_axle_joint>
        }

        def MjcActuator "wheel_2_axle_joint"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gear = [2, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/wheel_2_axle_link/wheel_2_axle_joint>
        }

        def MjcActuator "wheel_3_axle_joint"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            uniform double[] mjc:gear = [2, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/wheel_3_axle_link/wheel_3_axle_joint>
        }

        def MjcActuator "neck_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 3.14
            uniform double mjc:ctrlRange:min = -3.14
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/torso_link/neck_link/neck_joint>
        }

        def MjcActuator "head_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 1.5
            uniform double mjc:ctrlRange:min = -1.5
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/torso_link/neck_link/head_link/head_joint>
        }

        def MjcActuator "right_shoulder_pitch_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 2.6704
            uniform double mjc:ctrlRange:min = -3.0892
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/torso_link/right_shoulder_pitch_link/right_shoulder_pitch_joint>
        }

        def MjcActuator "right_shoulder_roll_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 1.5882
            uniform double mjc:ctrlRange:min = -2.2515
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/torso_link/right_shoulder_pitch_link/right_shoulder_roll_link/right_shoulder_roll_joint>
        }

        def MjcActuator "right_shoulder_yaw_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 2.618
            uniform double mjc:ctrlRange:min = -2.618
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/torso_link/right_shoulder_pitch_link/right_shoulder_roll_link/right_shoulder_yaw_link/right_shoulder_yaw_joint>
        }

        def MjcActuator "right_elbow_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 2.0944
            uniform double mjc:ctrlRange:min = -1.0472
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </asRoBallet/Geometry/base_link/torso_link/right_shoulder_pitch_link/right_shoulder_roll_link/right_shoulder_yaw_link/right_elbow_link/right_elbow_joint>
        }

        def MjcActuator "left_shoulder_pitch_joint"
        {
            uniform double[] mjc:biasPrm = [0, -100, 1, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 2.6704
            uniform double mjc:ctrlRange:min = -3.0892
            uniform double mjc:forceRange:max = 17
            uniform double mjc:forceRange:min = -17
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
