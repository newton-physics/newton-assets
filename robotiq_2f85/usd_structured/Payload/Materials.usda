#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.1.0a7"
    }
    defaultPrim = "robotiq_2f85"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "robotiq_2f85"
{
    def Scope "Materials"
    {
        def Material "black" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/black>
        )
        {
        }

        def Material "gray" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/gray>
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_mount"
        {
            over "base_mount" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </robotiq_2f85/Materials/black>
            }

            over "base"
            {
                over "base" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </robotiq_2f85/Materials/black>
                }

                over "right_driver"
                {
                    over "driver" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/gray>
                    }

                    over "right_coupler"
                    {
                        over "coupler" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </robotiq_2f85/Materials/black>
                        }
                    }
                }

                over "right_spring_link"
                {
                    over "spring_link" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/black>
                    }

                    over "right_follower"
                    {
                        over "follower" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </robotiq_2f85/Materials/black>
                        }

                        over "right_pad"
                        {
                            over "right_silicone_pad"
                            {
                                over "silicone_pad" (
                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                )
                                {
                                    rel material:binding = </robotiq_2f85/Materials/black>
                                }
                            }
                        }
                    }
                }

                over "left_driver"
                {
                    over "driver" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/gray>
                    }

                    over "left_coupler"
                    {
                        over "coupler" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </robotiq_2f85/Materials/black>
                        }
                    }
                }

                over "left_spring_link"
                {
                    over "spring_link" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </robotiq_2f85/Materials/black>
                    }

                    over "left_follower"
                    {
                        over "follower" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </robotiq_2f85/Materials/black>
                        }

                        over "left_pad"
                        {
                            over "left_silicone_pad"
                            {
                                over "silicone_pad" (
                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                )
                                {
                                    rel material:binding = </robotiq_2f85/Materials/black>
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

