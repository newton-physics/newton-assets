                            rel material:binding:physics = </robotiq_2f85/Physics/PhysicsMaterial>
                            uniform int mjc:group = 3
                            float newton:contactGap = 0
                            uniform token physics:approximation = "convexHull"
                            float physics:density = 1000
                        }

                        def PhysicsRevoluteJoint "left_follower_joint" (
                            prepend apiSchemas = ["MjcJointAPI"]
                        )
                        {
                            uniform double mjc:armature = 0.001
                            uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                            uniform double[] mjc:solreflimit = [0.005, 1]
                            uniform token physics:axis = "X"
                            rel physics:body0 = </robotiq_2f85/Geometry/base_mount/base/left_spring_link>
                            rel physics:body1 = </robotiq_2f85/Geometry/base_mount/base/left_spring_link/left_follower>
                            point3f physics:localPos0 = (-1.0339758e-25, 0.037, 0.044)
                            point3f physics:localPos1 = (0, -0.018, 0.0065)
                            quatf physics:localRot0 = (1, 0, 0, 0)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                            float physics:lowerLimit = -49.999966
                            float physics:upperLimit = 49.999966
                        }

                        def "left_pad" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                        )
                        {
                            point3f physics:centerOfMass = (0, -0.0025, 0.0185)
                            float3 physics:diagonalInertia = (4.73958e-7, 3.64583e-7, 1.23958e-7)
                            float physics:mass = 0.0035
                            quatf physics:principalAxes = (1, 0, 0, 1)

                            over "left_pad1" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                            )
                            {
                                rel material:binding:physics = </robotiq_2f85/Physics/PhysicsMaterial_1>
                                uniform int mjc:group = 3
                                uniform int mjc:priority = 1
                                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                                uniform double[] mjc:solref = [0.004, 1]
                                float newton:contactGap = 0
                                float physics:density = 1000
                                float physics:mass = 0
                            }

                            over "left_pad2" (
                                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                            )
                            {
                                rel material:binding:physics = </robotiq_2f85/Physics/PhysicsMaterial_2>
                                uniform int mjc:group = 3
                                uniform int mjc:priority = 1
                                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                                uniform double[] mjc:solref = [0.004, 1]
                                float newton:contactGap = 0
                                float physics:density = 1000
                                float physics:mass = 0
                            }

                            def PhysicsFixedJoint "PhysicsFixedJoint"
                            {
                                rel physics:body0 = </robotiq_2f85/Geometry/base_mount/base/left_spring_link/left_follower>
                                rel physics:body1 = </robotiq_2f85/Geometry/base_mount/base/left_spring_link/left_follower/left_pad>
                                point3f physics:localPos0 = (2.0679515e-25, -0.0189, 0.01352)
                                point3f physics:localPos1 = (0, 0, 0)
                                quatf physics:localRot0 = (1, 0, 0, 0)
                                quatf physics:localRot1 = (1, 0, 0, 0)
                            }

                            def "left_silicone_pad" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                            )
                            {
                                def PhysicsFixedJoint "PhysicsFixedJoint"
                                {
                                    rel physics:body0 = </robotiq_2f85/Geometry/base_mount/base/left_spring_link/left_follower/left_pad>
                                    rel physics:body1 = </robotiq_2f85/Geometry/base_mount/base/left_spring_link/left_follower/left_pad/left_silicone_pad>
                                    point3f physics:localPos0 = (3.85186e-34, 0, -1.3877788e-17)
                                    point3f physics:localPos1 = (0, 0, 0)
                                    quatf physics:localRot0 = (1, 0, 0, 0)
                                    quatf physics:localRot1 = (1, 0, 0, 0)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform token mjc:option:cone = "elliptic"
    uniform double mjc:option:impratio = 10
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

