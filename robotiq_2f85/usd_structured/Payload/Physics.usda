        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 0.6
        }

        def MjcTendon "split"
        {
            uniform token mjc:actuatorfrclimited = "false"
            prepend rel mjc:path = [
                </robotiq_2f85/Geometry/base_mount/base/right_driver/right_driver_joint>,
                </robotiq_2f85/Geometry/base_mount/base/left_driver/left_driver_joint>,
            ]
            uniform double[] mjc:path:coef = [0.5, 0.5]
            uniform int[] mjc:path:indices = [0, 1]
            uniform token mjc:type = "fixed"
        }

        def MjcActuator "fingers_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -100, -10, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:ctrlRange:max = 255
            uniform double mjc:forceRange:max = 5
            uniform double mjc:forceRange:min = -5
            uniform double[] mjc:gainPrm = [0.3137255, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </robotiq_2f85/Physics/split>
        }

        def PhysicsSphericalJoint "Equality" (
            prepend apiSchemas = ["MjcEqualityConnectAPI"]
        )
        {
            uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
            uniform double[] mjc:solref = [0.005, 1]
            uniform token physics:axis = "X"
            rel physics:body0 = </robotiq_2f85/Geometry/base_mount/base/right_spring_link/right_follower>
            rel physics:body1 = </robotiq_2f85/Geometry/base_mount/base/right_driver/right_coupler>
