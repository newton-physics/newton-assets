                                                uniform int mjc:group = 3
                                                uniform double[] mjc:solref = [0.02, 1]
                                                float newton:contactGap = 0
                                                uniform token physics:approximation = "convexHull"
                                                float physics:density = 1000
                                            }

                                            def PhysicsPrismaticJoint "joint_right" (
                                                prepend apiSchemas = ["MjcJointAPI", "NewtonJointAPI"]
                                            )
                                            {
                                                uniform double mjc:armature = 0.01
                                                uniform double mjc:damping = 1
                                                uniform double mjc:frictionloss = 0.2
                                                float newton:armature = 0.01
                                                float newton:damping = 1
                                                float newton:friction = 0.2
                                                uniform token physics:axis = "Z"
                                                rel physics:body0 = </seeed_rebot_devarm/Geometry/base_link/link1/link2/link3/link4/link5/link6/gripper_end>
                                                rel physics:body1 = </seeed_rebot_devarm/Geometry/base_link/link1/link2/link3/link4/link5/link6/gripper_end/gripper_right>
                                                point3f physics:localPos0 = (-0.041939, 0.000073385, 2.7755576e-17)
                                                point3f physics:localPos1 = (0, 0, 0)
                                                quatf physics:localRot0 = (0.5, -0.5, -0.5, -0.5)
                                                quatf physics:localRot1 = (1, 0, 0, 0)
                                                float physics:lowerLimit = 0
                                                float physics:upperLimit = 0.05
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform token mjc:option:cone = "elliptic"
    uniform double mjc:option:impratio = 10
    uniform token mjc:option:integrator = "implicitfast"
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

