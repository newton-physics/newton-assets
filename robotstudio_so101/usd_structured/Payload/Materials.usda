        )
        {
        }

        def Material "under_arm_so101_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/under_arm_so101_v1_material>
        )
        {
        }

        def Material "motor_holder_so101_wrist_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/motor_holder_so101_wrist_v1_material>
        )
        {
        }

        def Material "sts3215_03a_no_horn_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/sts3215_03a_no_horn_v1_material>
        )
        {
        }

        def Material "wrist_roll_pitch_so101_v2_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/wrist_roll_pitch_so101_v2_material>
        )
        {
        }

        def Material "wrist_roll_follower_so101_v1_material" (
