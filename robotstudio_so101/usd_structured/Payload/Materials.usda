                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </so101/Materials/motor_holder_so101_base_v1_material>
                }

                over "rotation_pitch_so101_v1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </so101/Materials/rotation_pitch_so101_v1_material>
                }

                over "upper_arm"
                {
                    over "sts3215_03a_v1" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </so101/Materials/sts3215_03a_v1_material>
                    }

                    over "upper_arm_so101_v1" (
