        }

        def Material "moving_jaw_so101_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/moving_jaw_so101_v1_material>
        )
        {
        }
    }

    over "Geometry"
    {
        over "base"
        {
            over "base_motor_holder_so101_v1" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </so101/Materials/base_motor_holder_so101_v1_material>
            }

            over "base_so101_v2" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </so101/Materials/base_so101_v2_material>
            }

            over "sts3215_03a_v1" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </so101/Materials/sts3215_03a_v1_material>
            }

            over "waveshare_mounting_plate_so101_v2" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </so101/Materials/waveshare_mounting_plate_so101_v2_material>
            }

            over "shoulder"
            {
                over "sts3215_03a_v1" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </so101/Materials/sts3215_03a_v1_material>
                }

