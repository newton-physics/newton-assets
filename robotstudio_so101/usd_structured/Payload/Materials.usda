#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.5.0"
    }
    defaultPrim = "so101"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "so101"
{
    def Scope "Materials"
    {
        def Material "base_motor_holder_so101_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/base_motor_holder_so101_v1_material>
        )
        {
        }

        def Material "base_so101_v2_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/base_so101_v2_material>
        )
        {
        }

        def Material "sts3215_03a_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/sts3215_03a_v1_material>
        )
        {
        }

        def Material "waveshare_mounting_plate_so101_v2_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/waveshare_mounting_plate_so101_v2_material>
        )
        {
        }

        def Material "motor_holder_so101_base_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/motor_holder_so101_base_v1_material>
        )
        {
        }

        def Material "rotation_pitch_so101_v1_material" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/rotation_pitch_so101_v1_material>
        )
        {
        }

        def Material "upper_arm_so101_v1_material" (
