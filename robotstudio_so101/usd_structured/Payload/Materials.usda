                        }

                        over "sts3215_03a_v1" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </so101/Materials/sts3215_03a_v1_material>
                        }

                        over "wrist"
                        {
                            over "sts3215_03a_no_horn_v1" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </so101/Materials/sts3215_03a_no_horn_v1_material>
                            }

                            over "wrist_roll_pitch_so101_v2" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </so101/Materials/wrist_roll_pitch_so101_v2_material>
                            }

                            over "gripper"
