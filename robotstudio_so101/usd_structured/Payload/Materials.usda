                                }

                                over "camera_mount"
                                {
                                    over "wrist_roll_follower_so101_camera_mount" (
                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                    )
                                    {
                                        rel material:binding = </so101/Materials/wrist_roll_follower_so101_v1_material>
                                    }
                                }

                                over "moving_jaw_so101_v1"
                                {
                                    over "moving_jaw_so101_v1" (
                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                    )
                                    {
                                        rel material:binding = </so101/Materials/moving_jaw_so101_v1_material>
                                    }
                                }
