                        rel physics:body0 = </Dual_wrist_camera/Geometry/base/right_spring_link>
                        rel physics:body1 = </Dual_wrist_camera/Geometry/base/right_spring_link/right_follower>
                        point3f physics:localPos0 = (-0.0382079, -0.0425003, 0.00295)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (-2.220446e-16, 1, 4.0601883e-18, -1.7500058e-17)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                        float physics:lowerLimit = -49.999966
                        float physics:upperLimit = 51.5662
                    }

                    def "right_pad" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                        over "right_pad1" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </Dual_wrist_camera/Physics/PhysicsMaterial_1>
                            uniform int mjc:group = 3
                            uniform int mjc:priority = 1
                            uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                            uniform double[] mjc:solref = [0.004, 1]
                            float newton:contactGap = 0
                            float physics:mass = 0.00175
                        }

                        over "right_pad2" (
                            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "MjcCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
                        )
                        {
                            rel material:binding:physics = </Dual_wrist_camera/Physics/PhysicsMaterial_2>
                            uniform int mjc:group = 3
                            uniform int mjc:priority = 1
                            uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                            uniform double[] mjc:solref = [0.004, 1]
                            float newton:contactGap = 0
                            float physics:mass = 0.00175
                        }

                        def PhysicsFixedJoint "PhysicsFixedJoint"
                        {
                            rel physics:body0 = </Dual_wrist_camera/Geometry/base/right_spring_link/right_follower>
                            rel physics:body1 = </Dual_wrist_camera/Geometry/base/right_spring_link/right_follower/right_pad>
                            point3f physics:localPos0 = (-0.0377897, -0.103916, -0.0091)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (0.70710677, -0.70710677, 8.318525e-18, 3.7053972e-17)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                        }
                    }
                }
            }
        }
    }
}

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["NewtonSceneAPI", "MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform token mjc:option:cone = "elliptic"
    uniform double mjc:option:impratio = 10
    uniform int newton:maxSolverIterations = 100
    uniform int newton:timeStepsPerSecond = 500
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
}

