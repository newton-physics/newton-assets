    }
    defaultPrim = "onerobotics_a1_left"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "onerobotics_a1_left"
{
    def Scope "Materials"
    {
        def Material "material_1" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_1>
        )
        {
        }

        def Material "material_2" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_2>
        )
        {
        }

        def Material "material_3" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_3>
        )
        {
        }

