            prepend references = @./MaterialsLibrary.usdc@</Materials/material_7>
        )
        {
        }

        def Material "material_8" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_8>
        )
        {
        }
    }

    over "Geometry"
    {
            over "base_link"
            {
                over "base_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </onerobotics_a1_left/Materials/material_1>
                }

                over "Link1"
                {
                    over "Link1" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </onerobotics_a1_left/Materials/material_2>
                    }

                    over "Link2"
                    {
                        over "Link2" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </onerobotics_a1_left/Materials/material_3>
                        }

                        over "Link3"
                        {
                            over "Link3" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </onerobotics_a1_left/Materials/material_4>
                            }

                            over "Link4"
                            {
                                over "Link4" (
                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                )
                                {
                                    rel material:binding = </onerobotics_a1_left/Materials/material_5>
                                }

                                over "Link5"
                                {
                                    over "Link5" (
                                        prepend apiSchemas = ["MaterialBindingAPI"]
                                    )
                                    {
                                        rel material:binding = </onerobotics_a1_left/Materials/material_6>
                                    }

                                    over "Link6"
