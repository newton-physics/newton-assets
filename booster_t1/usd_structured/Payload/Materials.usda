#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.1.0a7"
    }
    defaultPrim = "T1"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "T1"
{
    def Scope "Materials"
    {
        def Material "light_gray" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/light_gray>
        )
        {
        }

        def Material "medium_gray" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/medium_gray>
        )
        {
        }
    }

    over "Geometry"
    {
        over "Trunk"
        {
            over "Trunk" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </T1/Materials/light_gray>
            }

            over "Box" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </T1/Materials/medium_gray>
            }

            over "H1"
            {
